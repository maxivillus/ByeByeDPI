<resources>
    <style name="Theme.ByeDPI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorPrimaryVariant">#E5E5E5</item>
        <item name="colorOnPrimary">#000000</item>

        <item name="colorSecondary">#5976DF</item>
        <item name="colorSecondaryVariant">#3C52A3</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="android:statusBarColor">#000000</item>
        <item name="materialCardViewStyle">@style/SmallShadowCard</item>

        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenu</item>
        <item name="listPopupWindowStyle">@style/AppPopupMenu</item>

        <!-- popup menu item text sizes are resolved from the theme -->
        <item name="android:textAppearanceSmall">@style/AppPopupMenuText</item>
        <item name="android:textAppearanceListItemSmall">@style/AppPopupMenuText</item>
    </style>

    <style name="AppPopupMenu" parent="Widget.MaterialComponents.PopupMenu.ContextMenu">
        <item name="android:textAppearanceSmall">@style/AppPopupMenuText</item>
        <item name="android:textAppearanceListItemSmall">@style/AppPopupMenuText</item>
    </style>

    <style name="AppPopupMenuText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AppToolbar" parent="Widget.MaterialComponents.Toolbar.Surface" />

    <style name="CircleButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">60dp</item>
        <item name="android:textSize">0sp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <!-- -->
    </style>
</resources>
