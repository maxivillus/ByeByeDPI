<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/app_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/ssh_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ssh_name"
                android:inputType="text"
                android:maxLines="1" />

            <EditText
                android:id="@+id/ssh_hostname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ssh_hostname"
                android:inputType="textUri"
                android:maxLines="1" />

            <EditText
                android:id="@+id/ssh_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ssh_port"
                android:inputType="number"
                android:maxLines="1" />

            <EditText
                android:id="@+id/ssh_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ssh_username"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ssh_auth_type"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary" />

            <Spinner
                android:id="@+id/ssh_auth_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/ssh_password_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/ssh_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/ssh_password"
                    android:inputType="textPassword"
                    android:maxLines="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ssh_key_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ssh_key_source"
                    android:textSize="14sp"
                    android:textColor="?android:textColorSecondary" />

                <Spinner
                    android:id="@+id/ssh_pubkey_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/ssh_key_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ssh_key_select" />

                <TextView
                    android:id="@+id/ssh_key_file_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?android:textColorSecondary" />

                <EditText
                    android:id="@+id/ssh_key_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/ssh_key_password"
                    android:inputType="textPassword"
                    android:maxLines="1" />

            </LinearLayout>

            <EditText
                android:id="@+id/ssh_keepalive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/ssh_keepalive"
                android:inputType="number"
                android:maxLines="1" />

            <LinearLayout
                android:id="@+id/ssh_known_key_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ssh_known_key"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ssh_known_key_fp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary" />

                <Button
                    android:id="@+id/ssh_forget_key"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/ssh_forget_key" />

            </LinearLayout>

            <Button
                android:id="@+id/ssh_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/save" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
